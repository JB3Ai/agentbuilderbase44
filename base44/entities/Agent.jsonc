{
  "name": "Agent",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Agent name"
    },
    "role": {
      "type": "string",
      "description": "Agent role/title"
    },
    "department": {
      "type": "string",
      "description": "Department or division"
    },
    "check_in": {
      "type": "string",
      "description": "Check-in schedule (e.g. Daily, Monday & Thursday)"
    },
    "primary_outcome": {
      "type": "string",
      "description": "Primary outcome of this agent's work"
    },
    "status": {
      "type": "string",
      "enum": [
        "online",
        "busy",
        "offline"
      ],
      "default": "online"
    },
    "current_task": {
      "type": "string",
      "description": "What the agent is currently doing"
    },
    "task_status": {
      "type": "string",
      "enum": [
        "in_progress",
        "review",
        "stalled",
        "complete"
      ],
      "default": "in_progress",
      "description": "Current task progress status"
    },
    "task_progress": {
      "type": "number",
      "description": "Task completion percentage 0-100"
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "low"
    },
    "last_activity": {
      "type": "string",
      "description": "Last activity description"
    },
    "personality": {
      "type": "string",
      "description": "Agent personality description"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "List of skills"
    },
    "operating_principles": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Core operating principles"
    },
    "operational_notes": {
      "type": "string",
      "description": "Editable operational instructions and notes for this agent"
    },
    "age": {
      "type": "string"
    },
    "gender": {
      "type": "string"
    },
    "dress_code": {
      "type": "string"
    },
    "automation": {
      "type": "string",
      "description": "Automation settings/notes"
    },
    "memory": {
      "type": "string",
      "description": "Memory logs/notes"
    },
    "avatar_url": {
      "type": "string",
      "description": "URL to agent headshot"
    },
    "whatsapp_number": {
      "type": "string",
      "description": "WhatsApp number for chat connectivity (leave empty if not applicable)"
    },
    "superagent_id": {
      "type": "string",
      "description": "Superagent ID from the Base44 dashboard (e.g. 69eddd3fb35526e88df2b8c1). Used for direct chat connectivity."
    }
  },
  "required": [
    "name",
    "role"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}